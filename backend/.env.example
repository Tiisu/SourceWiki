# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MariaDB)
# To create the database locally with MariaDB:
#   mariadb -u root -e "CREATE DATABASE sourcewiki CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DB_DIALECT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sourcewiki

# Database Logging (set to true to enable SQL query logging in development)
# DB_LOGGING=false

# SQLite mode (alternative to MariaDB for quick local testing without a database server)
# Run `npm install sqlite3` in backend/ first:
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite

# Toolforge ToolsDB Credentials (automatically set in the Toolforge runtime environment)
# TOOL_TOOLSDB_USER=
# TOOL_TOOLSDB_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRE=7d

# Frontend CORS Origin (Vite default is http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Reverse Proxy Configuration (Toolforge deployment)
# Set to 1 behind Toolforge / reverse proxy to trust X-Forwarded-* headers
# TRUST_PROXY=1

# Rate Limiting
# Maximum API requests per 15-minute window for unauthenticated visitors
# ANON_RATE_LIMIT_MAX=50

# Email Service (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
SYSTEM_EMAIL_FROM=noreply@sourcewiki.toolforge.org

# Notification & Verifier Contact Emails
ADMIN_EMAIL=admin@sourcewiki.org
GHANA_VERIFIER_EMAIL=ghana-verifier@sourcewiki.org
NIGERIA_VERIFIER_EMAIL=nigeria-verifier@sourcewiki.org
